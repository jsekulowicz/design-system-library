{
  "name": "design-system-library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Framework-agnostic design system built on Lit web components, atomic design, token-based theming.",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:tokens": "pnpm --filter @jsekulowicz/ds-tokens build",
    "dev": "pnpm --filter @jsekulowicz/ds-core build && pnpm --filter @jsekulowicz/ds-components build && pnpm --parallel --filter \"@jsekulowicz/ds-core\" --filter \"@jsekulowicz/ds-components\" --filter \"@ds/storybook\" dev",
    "typecheck": "pnpm -r --parallel typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --parallel lint",
    "lint:dead-code": "knip --no-config-hints",
    "lint:packaging": "node scripts/lint-packaging.mjs",
    "lint:template-styles": "node scripts/lint-template-styles.mjs",
    "lint:lit": "eslint \"packages/{components,core}/src/**/*.ts\" --max-warnings=0",
    "lint:lit:analyzer": "lit-analyzer \"packages/components/src/**/*.ts\" \"packages/core/src/**/*.ts\" --rules.no-invalid-css off --quiet",
    "test": "pnpm -r --parallel test",
    "test:coverage": "pnpm --filter @jsekulowicz/ds-components test:coverage",
    "test:coverage:all": "pnpm -r --parallel --if-present test:coverage",
    "test:e2e": "pnpm --filter @ds/tests test:e2e",
    "test:a11y": "pnpm --filter @ds/tests test:a11y",
    "test:visual": "pnpm --filter @ds/tests test:visual",
    "test:visual:docker": "scripts/visual-docker.sh test:visual",
    "test:visual:update:docker": "scripts/visual-docker.sh test:visual:update",
    "test:visual:update:ci": "node scripts/request-visual-snapshots.mjs",
    "size": "pnpm -r --parallel size",
    "analyze": "pnpm --filter @jsekulowicz/ds-components analyze",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-storybook": "10.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-wc": "^3.1.0",
    "knip": "^6.32.0",
    "lit-analyzer": "^2.0.3",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "ts-lit-plugin": "^2.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
