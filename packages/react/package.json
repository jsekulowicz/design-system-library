{
  "name": "@jsekulowicz/ds-react",
  "version": "0.70.0",
  "description": "React wrappers for @jsekulowicz/ds-components built with @lit/react.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsekulowicz/design-system-library.git",
    "directory": "packages/react"
  },
  "homepage": "https://jsekulowicz.github.io/design-system-library",
  "bugs": {
    "url": "https://github.com/jsekulowicz/design-system-library/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "tsx scripts/generate-wrappers.ts",
    "clean": "rm -rf dist",
    "build": "pnpm clean && pnpm generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@jsekulowicz/ds-components": "workspace:*",
    "@lit/react": "^1.0.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3"
  }
}
