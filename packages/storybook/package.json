{
  "name": "@ds/storybook",
  "version": "0.1.0",
  "private": true,
  "description": "Storybook documentation site for the Design System Library.",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --disable-telemetry --no-version-updates",
    "build": "storybook build -o storybook-static --disable-telemetry",
    "lint": "eslint \".storybook/**/*.{ts,tsx}\" \"stories/**/*.ts\"",
    "preview": "http-server storybook-static -p 6006"
  },
  "dependencies": {
    "@jsekulowicz/ds-components": "workspace:*",
    "@jsekulowicz/ds-tokens": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/web-components-vite": "10.5.7",
    "@types/react": "^19.2.18",
    "http-server": "^14.1.1",
    "react": "^19.2.8",
    "storybook": "10.5.7",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
